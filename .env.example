# KubeShield configuration for running the API outside Kubernetes (development).
# Copy to .env and fill in values. In the lab these come from the
# kubeshield-secrets Secret created by scripts/lab-up.sh.

# Generate with: openssl rand -hex 32
KUBESHIELD_JWT_SECRET=
# Bearer token Falcosidekick must present to /api/v1/ingest/falco. openssl rand -hex 32
KUBESHIELD_INGEST_TOKEN=
# Password for the bootstrap "admin" user (only used when no users exist).
KUBESHIELD_ADMIN_PASSWORD=

# SQLite is fine for development; the lab uses PostgreSQL. Put the PostgreSQL
# password in PGPASSWORD rather than in the URL.
KUBESHIELD_DATABASE_URL=sqlite:///./kubeshield-dev.db

# in-cluster | kubeconfig | disabled
KUBESHIELD_KUBE_MODE=kubeconfig
KUBESHIELD_KUBE_CONTEXT=kind-kubeshield-lab
# Hubble Relay (use `kubectl -n kube-system port-forward svc/hubble-relay 4245:80` locally)
KUBESHIELD_HUBBLE_RELAY_ADDRESS=127.0.0.1:4245
# Only set false for plain-HTTP local development.
KUBESHIELD_COOKIE_SECURE=false
